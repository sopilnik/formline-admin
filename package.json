{
  "name": "formline-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin dashboard for the Formline poster store: per-visitor demo sandboxes, PostgreSQL row-level security, Next.js App Router",
  "author": "Alexandr Sopilnik",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "ios >= 17.5"
  ],
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:start": "esbuild scripts/container.ts --bundle --platform=node --format=esm --target=node26 --external:pg --outfile=dist/start.mjs --log-level=warning",
    "start": "node scripts/serve-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "pretest:e2e": "pnpm build && node tests/e2e/prepare-db.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
    "owner:recovery": "node --env-file-if-exists=.env scripts/owner-recovery.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@node-rs/argon2": "2.2.1",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/otp": "1.1.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.51.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.28.3"
}
