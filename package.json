{
  "name": "formline-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin dashboard for the Formline poster store: per-visitor demo sandboxes, PostgreSQL row-level security, Next.js App Router",
  "author": "Alexandr Sopilnik",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "node scripts/serve-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@oslojs/encoding": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
