# Local development against `pnpm db:up`. Never put real credentials in this file.
DATABASE_URL=postgres://app:app-local-password@127.0.0.1:56432/formline_dev
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@127.0.0.1:55432/formline_dev
ORIGIN_AUTH_DISABLED=1
LOG_LEVEL=debug
# ORIGIN_AUTH_SECRET= production only: the value the edge rule sends as X-Origin-Auth
# Local development values only; production values are set in the container settings (spec §5.7).
SITE_URL=http://localhost:3000
IP_HASH_KEY=local-development-ip-hash-key-0123456789
COOKIE_SIGNING_KEY=local-development-cookie-signing-key-01234
TOTP_ENCRYPTION_KEYS=dev1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
OWNER_SETUP_TOKEN=local-development-owner-setup-token-0123456789
# Uploaded images: a local folder here; production uses the bunny zone (BUNNY_STORAGE_ZONE, _HOST, _KEY).
MEDIA_STORAGE_DIR=.media
# The Stripe ingest (spec §7): all three or none; without them the webhook and the import answer 503.
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_RESTRICTED_KEY=rk_test_…
# PSEUDONYM_KEY= 32 bytes or more, e.g. openssl rand -base64 32
# STRIPE_API_BASE=http://127.0.0.1:4334 a local stand-in for Stripe's API (tests/e2e/stripe-stub.ts)
